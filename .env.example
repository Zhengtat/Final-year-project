# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# CR-001 §8: strong tier changed gpt-6-astra -> gpt-6-sol; gpt-6-astra is now an
# opt-in "ceiling" tier only (never a default model_tier anywhere in the code).
OPENAI_MODEL_STRONG=gpt-6-sol  # CR-023: the lower-cost profile sets o4-mini through CUMAP_MODELS_CONFIG below (use one or the other)
OPENAI_MODEL_BULK=gpt-6-luna
OPENAI_MODEL_CEILING=gpt-6-astra
# mock | openai  (tests always force mock)
CUMAP_LLM_BACKEND=openai

# CR-023: lower-cost model profile (strong tier o4-mini). Leave unset for the baseline gpt-6-sol.
# CUMAP_MODELS_CONFIG=configs/models_cr023.yaml
